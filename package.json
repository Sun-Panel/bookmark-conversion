{
  "name": "hslr-sun-panel-bookmark-conversion",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_ENV=development VITE_MICRO_MODE=dev vite",
    "build": "vite build",
    "build:dev": "npm run build:test",
    "pack": "npm run build && node build/pack.js",
    "pack:dev": "npm run pack:test",
    "gen": "node build/build.js",
    "gen:dev": "npm run gen:test",
    "preview": "vite preview",
    "demo": "vite --config vite.config.js --open demo-usage.html",
    "clean": "rm -rf dist .build packages",
    "test": "node build/build.js && echo 'Build test passed'",
    "lint": "eslint src config",
    "lint:fix": "eslint src config --fix",
    "update": "node scripts/update-template.mjs",
    "update:force": "node scripts/update-template.mjs --force",
    "update:dry-run": "node scripts/update-template.mjs --dry-run",
    "update:help": "node scripts/update-template.mjs --help",
    "build:test": "cross-env NODE_ENV=development VITE_MICRO_MODE=test vite build --mode development",
    "pack:test": "cross-env NODE_ENV=development node build/build.js --yes && npm run build:test && cross-env NODE_ENV=development node build/pack.js",
    "gen:test": "cross-env NODE_ENV=development node build/build.js --yes"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@sun-panel/micro-app": "^1.0.19",
    "adm-zip": "^0.5.10",
    "cross-env": "^7.0.3",
    "eslint": "^9.39.4",
    "globals": "^17.4.0",
    "vite": "^5.0.0",
    "vite-plugin-eslint": "^1.8.1"
  },
  "dependencies": {
    "jszip": "^3.10.1",
    "lit": "^3.3.2",
    "lit-html": "^3.3.2"
  },
  "templateName": "microapp-template",
  "templateVersion": "1.1.2"
}
